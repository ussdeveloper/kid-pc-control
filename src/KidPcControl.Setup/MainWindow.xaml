<Window x:Class="KidPcControl.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kid PC Control — Instalacja"
        Height="540" Width="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF0F1216"
        Foreground="#FFEEF2F7">
  <Border Background="#FF0F1216" Padding="28" TextElement.Foreground="#FFEEF2F7">
    <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <Image Source="pack://application:,,,/Assets/app.png" Width="52" Height="52" Margin="0,0,14,0"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Kid PC Control" FontSize="28" FontWeight="SemiBold" Foreground="#FFEEF2F7"/>
          <TextBlock Text="Wybierz rolę tej instalacji na Windows 11" Foreground="#FFB0BAC8" Margin="0,4,0,0"/>
        </StackPanel>
      </StackPanel>

      <RadioButton x:Name="RoleAdmin" Content="Admin — panel rodzica (podgląd i konfiguracja)" IsChecked="True" Margin="0,20,0,0"/>
      <RadioButton x:Name="RoleKid" Content="Kid — serwis + tray na komputerze dziecka"
                   Checked="RoleKid_OnChecked" Unchecked="RoleKid_OnUnchecked"/>

      <StackPanel x:Name="KidFields" Visibility="Collapsed" Margin="0,12,0,0">
        <TextBlock Text="Nazwa dziecka / urządzenia" Margin="0,0,0,4" Foreground="#FFB0BAC8"/>
        <TextBox x:Name="DeviceNameBox" Text="Pokój dziecka" Margin="0,0,0,12"/>
        <TextBlock Text="Hasło admina (override lokalny)" Margin="0,0,0,4" Foreground="#FFB0BAC8"/>
        <PasswordBox x:Name="AdminPasswordBox" Margin="0,0,0,8"/>
        <TextBlock Text="Potwierdź hasło" Margin="0,0,0,4" Foreground="#FFB0BAC8"/>
        <PasswordBox x:Name="AdminPasswordConfirmBox"/>
      </StackPanel>

      <TextBlock x:Name="ErrorText" Foreground="#FFFF6B81" Margin="0,16,0,0" TextWrapping="Wrap"/>

      <Button Style="{StaticResource PrimaryButton}" Content="Zainstaluj / skonfiguruj"
              HorizontalAlignment="Left" Margin="0,24,0,0" Click="Install_Click"/>
    </StackPanel>
  </Border>
</Window>
