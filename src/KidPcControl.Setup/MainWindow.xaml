<Window x:Class="KidPcControl.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kid PC Control — Instalacja"
        Height="520" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
  <Grid Margin="28">
    <StackPanel>
      <TextBlock Text="Kid PC Control" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock Text="Wybierz rolę tej instalacji na Windows 11"
                 Foreground="{StaticResource MutedBrush}" Margin="0,6,0,24"/>

      <RadioButton x:Name="RoleAdmin" Content="Admin — panel rodzica (podgląd i konfiguracja)" IsChecked="True"/>
      <RadioButton x:Name="RoleKid" Content="Kid — serwis + tray na komputerze dziecka" Checked="RoleKid_OnChecked" Unchecked="RoleKid_OnUnchecked"/>

      <StackPanel x:Name="KidFields" Visibility="Collapsed" Margin="0,8,0,0">
        <TextBlock Text="Nazwa dziecka / urządzenia" Margin="0,0,0,4"/>
        <TextBox x:Name="DeviceNameBox" Text="Pokój dziecka" Margin="0,0,0,12"/>
        <TextBlock Text="Hasło admina (override lokalny)" Margin="0,0,0,4"/>
        <PasswordBox x:Name="AdminPasswordBox" Margin="0,0,0,8"/>
        <TextBlock Text="Potwierdź hasło" Margin="0,0,0,4"/>
        <PasswordBox x:Name="AdminPasswordConfirmBox"/>
      </StackPanel>

      <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,16,0,0" TextWrapping="Wrap"/>

      <Button Style="{StaticResource PrimaryButton}" Content="Zainstaluj / skonfiguruj"
              HorizontalAlignment="Left" Margin="0,24,0,0" Click="Install_Click"/>
    </StackPanel>
  </Grid>
</Window>
