<Window x:Class="KidPcControl.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kid PC Control — Admin"
        Height="720" Width="1100"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Kid PC Control" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="Panel rodzica — urządzenia w sieci lokalnej"
                   Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="UpdateStatusText" VerticalAlignment="Center" Margin="0,0,12,0"
                   Foreground="{StaticResource MutedBrush}" Text="Aktualizacje: …"/>
        <Button Style="{StaticResource GhostButton}" Content="Odśwież" Click="Refresh_Click"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource CardBorder}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Urządzenia dzieci" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <ListBox x:Name="KidsList" SelectionChanged="KidsList_OnSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold"/>
                  <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12">
                    <Run Text="{Binding IpAddress}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding Version}"/>
                  </TextBlock>
                  <TextBlock FontSize="12" Margin="0,4,0,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Online"/>
                        <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding DeviceBlocked}" Value="True">
                            <Setter Property="Text" Value="Zablokowane"/>
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource CardBorder}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="DetailPanel">
            <TextBlock x:Name="SelectedTitle" Text="Wybierz urządzenie" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="SelectedMeta" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,20"
                       Text="Po uruchomieniu trybu Kid w tej samej sieci pojawi się tutaj."/>

            <TextBlock Text="Godziny dostępu" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Od" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="StartHourBox" Text="07:00"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Do" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="EndHourBox" Text="21:00"/>
              </StackPanel>
            </Grid>

            <TextBlock Text="Max. ciągły czas (minuty)" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBox x:Name="MaxUseBox" Text="120" Margin="0,0,0,16"/>

            <TextBlock Text="Blokada URL (regex, jeden w linii)" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBox x:Name="UrlRegexBox" AcceptsReturn="True" Height="90" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>
            <TextBox x:Name="UrlMessageBox" Text="Ta strona jest zablokowana przez rodzica." Margin="0,0,0,16"/>

            <TextBlock Text="Komunikat blokady urządzenia" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBox x:Name="LockMessageBox" Text="Czas na przerwę. Poproś rodzica o odblokowanie." Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource PrimaryButton}" Content="Zapisz politykę lokalnie" Click="SavePolicy_Click" Margin="0,0,8,0"/>
              <Button Style="{StaticResource GhostButton}" Content="Zablokuj teraz" Click="BlockNow_Click" Margin="0,0,8,0"/>
              <Button Style="{StaticResource GhostButton}" Content="Odblokuj" Click="Unblock_Click"/>
            </StackPanel>

            <TextBlock Margin="0,16,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       Text="Uwaga: pełny push polityki przez sieć (gRPC) i podgląd ekranu będą w kolejnych iteracjach. Teraz działa discovery LAN + edycja lokalnego szablonu polityki."/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <TextBlock Grid.Row="2" Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}"
               Text="Kid PC Control · Windows 11 · sieć lokalna"/>
  </Grid>
</Window>
