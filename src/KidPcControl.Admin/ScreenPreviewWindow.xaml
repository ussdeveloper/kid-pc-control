<Window x:Class="KidPcControl.Admin.ScreenPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Podgląd ekranu Kid"
        Height="820" Width="1180"
        MinHeight="520" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="#FF0F1216"
        Foreground="#FFEEF2F7">
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Bottom" Background="#FF161A20" BorderBrush="#FF3D4653" BorderThickness="1"
            CornerRadius="8" Padding="12" Margin="0,10,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Zaznacz prostokąt (lewy przycisk) · scroll = zoom · środkowy / Shift+przeciągnij = pan"
                     Foreground="#FFB0BAC8" FontSize="12" Margin="0,0,0,8"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NoteBox" Text="" ToolTip="Tekst widoczny na ekranie dziecka"
                     Foreground="#FFEEF2F7" Background="#FF0A0D11" CaretBrush="#FFEEF2F7"/>
            <TextBox x:Name="SecondsBox" Grid.Column="2" Text="15" ToolTip="Czas wyświetlenia (s)"
                     Foreground="#FFEEF2F7" Background="#FF0A0D11" CaretBrush="#FFEEF2F7"
                     HorizontalContentAlignment="Center"/>
          </Grid>
          <TextBlock x:Name="StatusText" Foreground="#FF00D4C8" FontSize="12" Margin="0,8,0,0"
                     Text="Zaznacz obszar, wpisz tekst i wyślij."/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
          <Button Style="{StaticResource GhostButton}" Content="Wyczyść" Click="Clear_Click" Margin="0,0,8,0"/>
          <Button Style="{StaticResource PrimaryButton}" Content="Wyślij na Kid (15s)" Click="Send_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Background="#FF0A0D11" BorderBrush="#FF3D4653" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
      <ScrollViewer x:Name="Scroller"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    CanContentScroll="False"
                    PreviewMouseWheel="Scroller_OnPreviewMouseWheel"
                    PreviewMouseDown="Scroller_OnPreviewMouseDown"
                    PreviewMouseMove="Scroller_OnPreviewMouseMove"
                    PreviewMouseUp="Scroller_OnPreviewMouseUp"
                    Background="#FF0A0D11">
        <Grid x:Name="ImageHost" Background="#FF0A0D11">
          <Image x:Name="PreviewImage"
                 Stretch="None"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 RenderTransformOrigin="0,0">
            <Image.RenderTransform>
              <TransformGroup>
                <ScaleTransform x:Name="ZoomScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="PanOffset"/>
              </TransformGroup>
            </Image.RenderTransform>
          </Image>
          <Canvas x:Name="SelectLayer" IsHitTestVisible="False">
            <Rectangle x:Name="SelectionRect"
                       Stroke="#FFFF4D6D"
                       StrokeThickness="2"
                       Fill="#33FF4D6D"
                       Visibility="Collapsed"/>
          </Canvas>
        </Grid>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
