<Window x:Class="KidPcControl.Agent.AnnotationOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kid annotate"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        IsHitTestVisible="False"
        Focusable="False">
  <Canvas x:Name="RootCanvas">
    <Border x:Name="Highlight"
            BorderBrush="#FFFF4D6D"
            BorderThickness="3"
            Background="#33FF4D6D"
            CornerRadius="4"/>
    <Border x:Name="Caption"
            Background="#E6101216"
            BorderBrush="#FFFF4D6D"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12,8"
            MaxWidth="420">
      <TextBlock x:Name="CaptionText"
                 Foreground="#FFEEF2F7"
                 FontSize="18"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap"/>
    </Border>
  </Canvas>
</Window>
