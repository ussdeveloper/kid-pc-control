<Window x:Class="KidPcControl.Agent.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kid PC Control"
        WindowState="Maximized"
        WindowStyle="None"
        Topmost="True"
        Background="#FF0F1216"
        Foreground="#FFEEF2F7">
  <Border Background="#E6101010">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640">
      <TextBlock Text="Kid PC Control" FontSize="18" Foreground="#FF00D4C8" HorizontalAlignment="Center"/>
      <TextBlock x:Name="MessageText" Text="Czas na przerwę."
                 FontSize="36" FontWeight="SemiBold" TextWrapping="Wrap"
                 TextAlignment="Center" Margin="0,16,0,12" Foreground="#FFEEF2F7"/>
      <TextBlock Text="Poproś rodzica o hasło admina w ikonie tray, aby dodać czas lub wyłączyć limity."
                 Foreground="#FFB0BAC8" TextWrapping="Wrap" TextAlignment="Center"/>
      <Button Style="{StaticResource PrimaryButton}" Content="Odśwież status"
              Margin="0,28,0,0" HorizontalAlignment="Center" Click="Refresh_Click"/>
    </StackPanel>
  </Border>
</Window>
